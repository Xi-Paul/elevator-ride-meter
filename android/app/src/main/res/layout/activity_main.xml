<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151B25"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#F2B33D"
            android:text="시작"
            android:textColor="#151B25"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAbort"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_bg"
            android:lines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="취소\n(폐기)"
            android:textColor="#FF7D6E"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_bg"
            android:lines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="🎤 음성\n꺼짐"
            android:textColor="#8D9AB0"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:text=""
        android:textColor="#8D9AB0"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="승강기 주행 계측"
                    android:textColor="#E8EDF5"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— Hz"
                    android:textColor="#8D9AB0"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:text="상승"
                    android:textColor="#E8EDF5" />

                <Button
                    android:id="@+id/btnDown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:text="하강"
                    android:textColor="#E8EDF5" />
            </LinearLayout>

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/trialBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal" />

                <Spinner
                    android:id="@+id/spTrials"
                    android:layout_width="86dp"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="표시 축"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spAxis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <CheckBox
                    android:id="@+id/cbAutoDir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="방향 자동"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvK1"
                        android:text="가속도 m/s²"
                        android:textColor="#8D9AB0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#F2B33D"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAmm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="max 0.00\nmin 0.00"
                        android:textColor="#E8EDF5"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvK2"
                        android:text="속도 m/s"
                        android:textColor="#8D9AB0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#5CC8FF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVmm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="max 0.00\nmin 0.00"
                        android:textColor="#E8EDF5"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/panel_bg"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvK3"
                        android:text="저크 m/s³"
                        android:textColor="#8D9AB0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvJ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#FF7D6E"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJmm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="max 0.00\nmin 0.00"
                        android:textColor="#E8EDF5"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <kr.xi.ridemeter.ChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/panel_bg" />

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="가속"
                    android:textColor="#F2B33D"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="속도"
                    android:textColor="#5CC8FF"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbJ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="저크"
                    android:textColor="#FF7D6E"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="전후"
                    android:textColor="#9B8CFF"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="좌우"
                    android:textColor="#63D39A"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="원시"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ToggleButton
                    android:id="@+id/tgFft"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:textOff="시간"
                    android:textOn="스펙트럼"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:tag="cfg"
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/panel_bg"
                android:padding="10dp"
                android:text="—"
                android:textColor="#E8EDF5"
                android:textSize="12sp" />

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="샘플링"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spRate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자동정지"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spAuto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LPF"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spFc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="저크"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spJfc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FFT축"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spFax"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="구간"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spSeg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbNoise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="소음 측정"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="보정 dB"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/edNcal"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned"
                    android:text="0"
                    android:textColor="#E8EDF5"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 = 미보정(dBFS)"
                    android:textColor="#5D6B82"
                    android:textSize="10sp" />
            </LinearLayout>

            <CheckBox
                android:tag="cfg"
                android:id="@+id/cbUncal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="무보정 가속도계 사용 (지원 시)"
                android:textColor="#8D9AB0"
                android:textSize="11sp" />

            <TextView
                android:tag="cfg"
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/panel_bg"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="—"
                android:textColor="#8D9AB0"
                android:textSize="11sp" />

            <TextView
                android:tag="cfg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="설비 제원 (주파수 원인 추정용)"
                android:textColor="#8D9AB0"
                android:textSize="12sp" />

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edDia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="시브 직경 mm"
                    android:inputType="numberDecimal"
                    android:textColor="#E8EDF5"
                    android:textColorHint="#5D6B82"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spRope"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <EditText
                    android:id="@+id/edPole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="극수"
                    android:inputType="numberDecimal"
                    android:textColor="#E8EDF5"
                    android:textColorHint="#5D6B82"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edGear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="감속비 (기어리스 1)"
                    android:inputType="numberDecimal"
                    android:textColor="#E8EDF5"
                    android:textColorHint="#5D6B82"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edRail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="레일 길이 m (5)"
                    android:inputType="numberDecimal"
                    android:textColor="#E8EDF5"
                    android:textColorHint="#5D6B82"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edBrk"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="브래킷 m (2.5)"
                    android:inputType="numberDecimal"
                    android:textColor="#E8EDF5"
                    android:textColorHint="#5D6B82"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:tag="cfg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="리포트 정보"
                android:textColor="#8D9AB0"
                android:textSize="12sp" />

            <EditText
                android:tag="cfg"
                android:id="@+id/edSite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="현장명"
                android:inputType="text"
                android:textColor="#E8EDF5"
                android:textColorHint="#5D6B82"
                android:textSize="13sp" />

            <EditText
                android:tag="cfg"
                android:id="@+id/edUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="호기 / 기종"
                android:inputType="text"
                android:textColor="#E8EDF5"
                android:textColorHint="#5D6B82"
                android:textSize="13sp" />

            <EditText
                android:tag="cfg"
                android:id="@+id/edSpec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="정격 속도 · 적재"
                android:inputType="text"
                android:textColor="#E8EDF5"
                android:textColorHint="#5D6B82"
                android:textSize="13sp" />

            <EditText
                android:tag="cfg"
                android:id="@+id/edBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="측정자"
                android:inputType="text"
                android:textColor="#E8EDF5"
                android:textColorHint="#5D6B82"
                android:textSize="13sp" />

            <EditText
                android:tag="cfg"
                android:id="@+id/edMail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="메일 수신자 (쉼표로 여러 명)"
                android:inputType="textEmailAddress"
                android:textColor="#E8EDF5"
                android:textColorHint="#5D6B82"
                android:textSize="13sp" />

            <EditText
                android:tag="cfg"
                android:id="@+id/edAddr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="주소 (위치 확인 시 자동)"
                android:inputType="text"
                android:textColor="#E8EDF5"
                android:textColorHint="#5D6B82"
                android:textSize="13sp" />

            <LinearLayout
                android:tag="cfg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGeo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_bg"
                    android:text="현재 위치"
                    android:textColor="#E8EDF5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvGeo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="좌표 없음"
                    android:textColor="#8D9AB0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCsv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:text="CSV"
            android:textColor="#E8EDF5"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLoad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:text="불러오기"
            android:textColor="#E8EDF5"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:text="초기화"
            android:textColor="#E8EDF5"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:text="리포트"
            android:textColor="#E8EDF5"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnMail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:text="메일"
            android:textColor="#E8EDF5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
